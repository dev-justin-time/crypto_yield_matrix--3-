{
  "identity": {
    "agentName": "defi_liquidity_analyst",
    "displayName": "DeFi Liquidity Analyst",
    "description": "Reviews volume trends, TVL depth, active addresses, daily transactions, and market-cap context to identify weakening liquidity signals and exit-risk proxies before they become critical. Flags assets where high yield may be accompanied by thin market depth.",
    "version": "1.1.0",
    "provider": {
      "organization": "Crypto Yield Matrix"
    }
  },
  "capabilities": {
    "taskKinds": [
      "request"
    ],
    "expertise": [
      "liquidity analysis",
      "volume trend detection",
      "TVL evaluation",
      "on-chain activity assessment",
      "market depth proxy",
      "exit-risk screening"
    ],
    "dataCoverage": "59 assets, volume/TVL/address/transaction metrics, 8 quarters of trend data"
  },
  "tags": [
    {
      "id": "domain:crypto",
      "name": "Cryptocurrency"
    },
    {
      "id": "domain:defi",
      "name": "DeFi"
    },
    {
      "id": "task:liquidity",
      "name": "Liquidity and activity analysis"
    },
    {
      "id": "task:screening",
      "name": "Asset screening"
    },
    {
      "id": "skill:on-chain",
      "name": "On-chain metrics"
    },
    {
      "id": "format:json",
      "name": "Structured JSON output"
    }
  ],
  "runtime": {
    "handler": "./handler.py",
    "handlerExport": "handler",
    "concurrency": 4,
    "expectedInstances": 1,
    "maxPendingBacklog": 20,
    "maxRunningTimeSec": 45
  },
  "io": {
    "inputs": [
      {
        "id": "request",
        "description": "Liquidity question with optional symbol, category, and warning thresholds.",
        "contentType": "application/json",
        "required": true,
        "schema": {
          "type": "object",
          "properties": {
            "question": {
              "type": "string"
            },
            "source_file": {
              "type": "string",
              "enum": [
                "yield_data.csv"
              ]
            },
            "symbol": {
              "type": "string"
            },
            "category": {
              "type": "string"
            },
            "files": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "question"
          ]
        },
        "example": {
          "question": "Analyze BTC using the repository-backed expert skill.",
          "source_file": "yield_data.csv",
          "symbol": "BTC"
        }
      }
    ],
    "outputs": [
      {
        "id": "liquidity_report",
        "description": "Liquidity-health report with proxy metrics and explicit blind spots.",
        "contentType": "application/json",
        "guaranteed": true
      }
    ]
  }
}
