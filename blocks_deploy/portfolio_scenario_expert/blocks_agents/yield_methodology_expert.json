{
  "identity": {
    "agentName": "yield_methodology_expert",
    "displayName": "Yield Methodology Expert",
    "description": "Explains and compares crypto yield mechanisms, annualization flags, aggregates, and methodology notes without treating unlike yields as interchangeable.",
    "version": "1.0.0",
    "provider": {
      "organization": "Crypto Yield Matrix"
    }
  },
  "capabilities": {
    "taskKinds": [
      "request"
    ]
  },
  "tags": [
    {
      "id": "yield",
      "name": "Yield methodology"
    }
  ],
  "runtime": {
    "handler": "./handlers/yield_methodology_expert.py"
  },
  "contextFiles": [
    "validate.md",
    "DATA_DICTIONARY.md",
    "yield_data.csv"
  ],
  "io": {
    "inputs": [
      {
        "id": "request",
        "description": "Yield comparison question and optional asset/category filter.",
        "contentType": "application/json",
        "required": true,
        "schema": {
          "type": "object",
          "properties": {
            "question": {
              "type": "string"
            },
            "symbol": {
              "type": "string"
            },
            "category": {
              "type": "string"
            },
            "metrics": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    ],
    "outputs": [
      {
        "id": "yield_report",
        "description": "Comparable yield analysis with methodology, annualization status, and caveats.",
        "contentType": "application/json",
        "guaranteed": true
      }
    ]
  },
  "skill": {
    "fields": [
      "q3_24_prior",
      "q4_24_prior",
      "q1_25_prior",
      "q2_25_prior",
      "q3_25_current",
      "q4_25_current",
      "q1_26_current",
      "q2_26_current",
      "agg_prior",
      "agg_current",
      "change_pp",
      "is_annualized",
      "notes",
      "category"
    ],
    "mustReport": [
      "yield type",
      "annualization status",
      "source version",
      "methodology note"
    ]
  }
}
