{
  "identity": {
    "agentName": "portfolio_scenario_expert",
    "displayName": "Portfolio Scenario Expert",
    "description": "Runs transparent crypto yield/risk/liquidity scenarios under user-defined constraints. What-if analysis for yield targets, drawdown caps, liquidity floors, and category limits. Outputs include constraint violations, trade-off analysis, and sensitivity flags \u2014 never a recommendation.",
    "version": "1.1.0",
    "provider": {
      "organization": "Crypto Yield Matrix"
    }
  },
  "capabilities": {
    "taskKinds": [
      "request"
    ]
  },
  "tags": [
    {
      "id": "domain:crypto",
      "name": "Cryptocurrency"
    },
    {
      "id": "task:scenarios",
      "name": "Portfolio scenarios"
    },
    {
      "id": "task:what-if",
      "name": "What-if analysis"
    },
    {
      "id": "skill:portfolio",
      "name": "Portfolio research"
    },
    {
      "id": "format:json",
      "name": "Structured JSON output"
    },
    {
      "id": "skill:scenario_analysis",
      "name": "scenario analysis"
    },
    {
      "id": "skill:constraint-based_screening",
      "name": "constraint-based screening"
    },
    {
      "id": "skill:trade-off_evaluation",
      "name": "trade-off evaluation"
    },
    {
      "id": "skill:sensitivity_analysis",
      "name": "sensitivity analysis"
    },
    {
      "id": "skill:portfolio_construction_research",
      "name": "portfolio construction research"
    },
    {
      "id": "info:data-coverage",
      "name": "59 assets, yield/drawdown/vol/liquidity/correlation metrics across 16 categories"
    }
  ],
  "runtime": {
    "handler": "./handler.py",
    "handlerExport": "handler",
    "concurrency": 4,
    "expectedInstances": 1,
    "maxPendingBacklog": 20,
    "maxRunningTimeSec": 45
  },
  "io": {
    "inputs": [
      {
        "id": "request",
        "description": "Scenario constraints such as target yield, drawdown cap, liquidity floor, and category limits.",
        "contentType": "application/json",
        "required": true,
        "schema": {
          "type": "object",
          "properties": {
            "question": {
              "type": "string"
            },
            "source_file": {
              "type": "string",
              "enum": [
                "yield_data.csv"
              ]
            },
            "symbol": {
              "type": "string"
            },
            "category": {
              "type": "string"
            },
            "files": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "question"
          ]
        },
        "example": {
          "question": "Analyze BTC using the repository-backed expert skill.",
          "source_file": "yield_data.csv",
          "symbol": "BTC"
        }
      }
    ],
    "outputs": [
      {
        "id": "scenario_report",
        "description": "Assumptions, trade-offs, constraints, sensitivity, and evidence-backed scenario output.",
        "contentType": "application/json",
        "guaranteed": true
      }
    ]
  }
}
