{
  "identity": {
    "agentName": "crypto_risk_analyst",
    "displayName": "Crypto Risk Analyst",
    "description": "Quantifies downside risk alongside yield: volatility, drawdown, beta, Sharpe ratios, and risk-adjusted return. Flags assets where yield masks elevated risk. Best used as a screening tool before deeper liquidity and tokenomics review.",
    "version": "1.1.0",
    "provider": {
      "organization": "Crypto Yield Matrix"
    }
  },
  "capabilities": {
    "taskKinds": ["request"],
    "expertise": ["risk assessment", "volatility analysis", "drawdown evaluation", "yield-risk trade-off", "beta and correlation"],
    "dataCoverage": "59 assets across 16 categories, 8 quarterly yield observations, 9 source-backed market snapshots"
  },
  "tags": [
    {"id": "domain:crypto", "name": "Cryptocurrency"},
    {"id": "task:risk", "name": "Risk and drawdown analysis"},
    {"id": "task:screening", "name": "Asset screening"},
    {"id": "skill:quantitative", "name": "Quantitative metrics"},
    {"id": "format:json", "name": "Structured JSON output"}
  ],
  "runtime": {
    "handler": "./handler.py",
    "handlerExport": "handler",
    "concurrency": 4,
    "expectedInstances": 1,
    "maxPendingBacklog": 20,
    "maxRunningTimeSec": 45
  },
  "io": {
    "inputs": [
      {
        "id": "request",
        "description": "Risk question, asset filter, and optional thresholds.",
        "contentType": "application/json",
        "required": true,
        "schema": {
          "type": "object",
          "properties": {
            "question": {
              "type": "string"
            },
            "source_file": {
              "type": "string",
              "enum": [
                "yield_data.csv"
              ]
            },
            "symbol": {
              "type": "string"
            },
            "category": {
              "type": "string"
            },
            "files": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "question"
          ]
        },
        "example": {
          "question": "Analyze BTC using the repository-backed expert skill.",
          "source_file": "yield_data.csv",
          "symbol": "BTC"
        }
      }
    ],
    "outputs": [
      {
        "id": "risk_report",
        "description": "Risk/yield comparison with evidence, severity, and limitations.",
        "contentType": "application/json",
        "guaranteed": true
      }
    ]
  }
}
