{
  "identity": {
    "agentName": "matrix_research_insights_agent",
    "displayName": "Matrix Research Insights Agent",
    "description": "Converts the interactive yield matrix dashboard into traceable research insights. Explains quarter-by-quarter yield rankings, prior/current aggregate comparisons, yield bands, and timeline metrics with exact source references. Ideal for generating research notes directly from dashboard exploration.",
    "version": "1.1.0",
    "provider": {
      "organization": "Crypto Yield Matrix"
    }
  },
  "capabilities": {
    "taskKinds": [
      "request"
    ]
  },
  "tags": [
    {
      "id": "domain:crypto",
      "name": "Cryptocurrency"
    },
    {
      "id": "task:insights",
      "name": "Dashboard research insights"
    },
    {
      "id": "task:ranking",
      "name": "Yield ranking and comparison"
    },
    {
      "id": "skill:interpretation",
      "name": "Data interpretation"
    },
    {
      "id": "format:json",
      "name": "Structured JSON output"
    },
    {
      "id": "skill:dashboard_research",
      "name": "dashboard research"
    },
    {
      "id": "skill:yield_ranking_analysis",
      "name": "yield ranking analysis"
    },
    {
      "id": "skill:quarterly_comparison",
      "name": "quarterly comparison"
    },
    {
      "id": "skill:aggregate_trend_interpretation",
      "name": "aggregate trend interpretation"
    },
    {
      "id": "skill:matrix_data_extraction",
      "name": "matrix data extraction"
    },
    {
      "id": "info:data-coverage",
      "name": "8 quarters, 59 assets, 6 focus assets, 4 yield bands, investment score breakdown"
    }
  ],
  "runtime": {
    "handler": "./handler.py",
    "handlerExport": "handler",
    "concurrency": 4,
    "expectedInstances": 1,
    "maxPendingBacklog": 20,
    "maxRunningTimeSec": 45
  },
  "io": {
    "inputs": [
      {
        "id": "request",
        "description": "User question about the matrix, quarter, asset, aggregate, legend, or timeline.",
        "contentType": "application/json",
        "required": true,
        "schema": {
          "type": "object",
          "properties": {
            "question": {
              "type": "string"
            },
            "source_file": {
              "type": "string",
              "enum": [
                "yield_data.csv"
              ]
            },
            "symbol": {
              "type": "string"
            },
            "category": {
              "type": "string"
            },
            "files": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "question"
          ]
        },
        "example": {
          "question": "Analyze BTC using the repository-backed expert skill.",
          "source_file": "yield_data.csv",
          "symbol": "BTC"
        }
      }
    ],
    "outputs": [
      {
        "id": "insight_report",
        "description": "Plain-language insight with exact field and source references.",
        "contentType": "application/json",
        "guaranteed": true
      }
    ]
  }
}
