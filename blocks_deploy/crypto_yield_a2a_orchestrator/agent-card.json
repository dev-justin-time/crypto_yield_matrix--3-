{
  "identity": {
    "agentName": "crypto_yield_a2a_orchestrator",
    "displayName": "Crypto Yield A2A Orchestrator",
    "description": "Coordinates private crypto yield specialists in parallel and merges their evidence into one research artifact.",
    "version": "1.1.0",
    "provider": {
      "organization": "Crypto Yield Matrix"
    }
  },
  "capabilities": {
    "taskKinds": [
      "request"
    ]
  },
  "tags": [
    {
      "id": "orchestration",
      "name": "Agent orchestration"
    },
    {
      "id": "crypto_research",
      "name": "Crypto research"
    }
  ],
  "runtime": {
    "handler": "./handler.py",
    "handlerExport": "handler",
    "concurrency": 2,
    "expectedInstances": 1,
    "maxPendingBacklog": 8,
    "maxRunningTimeSec": 90
  },
  "io": {
    "inputs": [
      {
        "id": "request",
        "description": "A JSON research request routed to multiple crypto specialists.",
        "contentType": "application/json",
        "required": true,
        "schema": {
          "type": "object",
          "properties": {
            "question": {
              "type": "string"
            },
            "source_file": {
              "type": "string",
              "enum": [
                "yield_data.csv"
              ]
            },
            "symbol": {
              "type": "string"
            },
            "category": {
              "type": "string"
            },
            "files": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "question"
          ]
        },
        "example": {
          "question": "Give me a combined BTC yield, risk, liquidity, tokenomics, feature, and provenance analysis.",
          "source_file": "yield_data.csv",
          "symbol": "BTC"
        }
      }
    ],
    "outputs": [
      {
        "id": "orchestration_report",
        "description": "Merged specialist JSON with partial-failure status and provenance.",
        "contentType": "application/json",
        "guaranteed": true
      }
    ]
  }
}
