{
  "identity": {
    "agentName": "data_provenance_auditor",
    "displayName": "Data Provenance Auditor",
    "description": "Audits CSV lineage, schema compatibility, source conflicts, and validation evidence for the crypto yield matrix.",
    "version": "1.1.0",
    "provider": {
      "organization": "Crypto Yield Matrix"
    }
  },
  "capabilities": {
    "taskKinds": [
      "request"
    ]
  },
  "tags": [
    {
      "id": "provenance",
      "name": "Data provenance and audit"
    }
  ],
  "runtime": {
    "handler": "./handler.py",
    "handlerExport": "handler",      "concurrency": 4,
      "expectedInstances": 1,
      "maxPendingBacklog": 20,
      "maxRunningTimeSec": 45
  },
  "io": {
    "inputs": [
      {
        "id": "request",
        "description": "Audit question, symbols, or files to inspect.",
        "contentType": "application/json",
        "required": true,
        "schema": {
          "type": "object",
          "properties": {
            "question": {
              "type": "string"
            },
            "source_file": {
              "type": "string",
              "enum": [
                "yield_data.csv",
                "yield_data1.csv"
              ]
            },
            "symbol": {
              "type": "string"
            },
            "category": {
              "type": "string"
            },
            "files": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "question"
          ]
        },
        "example": {
          "question": "Analyze BTC using the repository-backed expert skill.",
          "source_file": "yield_data.csv",
          "symbol": "BTC"
        }
      }
    ],
    "outputs": [
      {
        "id": "audit_report",
        "description": "Structured audit with PASS, WARNING, or FAIL status and exact evidence locations.",
        "contentType": "application/json",
        "guaranteed": true
      }
    ]
  }
}
