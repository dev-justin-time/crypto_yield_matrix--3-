{
  "identity": {
    "agentName": "data_provenance_auditor",
    "displayName": "Data Provenance Auditor",
    "description": "Audits CSV lineage, schema consistency, source conflicts, duplicate provenance rows, and validation evidence. Returns exact file/row/column references for every finding. Essential before trusting any downstream analysis or model output.",
    "version": "1.1.0",
    "provider": {
      "organization": "Crypto Yield Matrix"
    }
  },
  "capabilities": {
    "taskKinds": [
      "request"
    ],
    "expertise": [
      "data lineage audit",
      "schema validation",
      "source conflict detection",
      "provenance tracking",
      "hash verification"
    ],
    "dataCoverage": "118 provenance-labeled rows, 61 columns, 9 source snapshots, SHA-256 verified mirrors"
  },
  "tags": [
    {
      "id": "domain:crypto",
      "name": "Cryptocurrency"
    },
    {
      "id": "task:audit",
      "name": "Data auditing"
    },
    {
      "id": "task:provenance",
      "name": "Provenance tracking"
    },
    {
      "id": "skill:data-quality",
      "name": "Data quality assurance"
    },
    {
      "id": "format:json",
      "name": "Structured JSON output"
    }
  ],
  "runtime": {
    "handler": "./handler.py",
    "handlerExport": "handler",
    "concurrency": 4,
    "expectedInstances": 1,
    "maxPendingBacklog": 20,
    "maxRunningTimeSec": 45
  },
  "io": {
    "inputs": [
      {
        "id": "request",
        "description": "Audit question, symbols, or files to inspect.",
        "contentType": "application/json",
        "required": true,
        "schema": {
          "type": "object",
          "properties": {
            "question": {
              "type": "string"
            },
            "source_file": {
              "type": "string",
              "enum": [
                "yield_data.csv"
              ]
            },
            "symbol": {
              "type": "string"
            },
            "category": {
              "type": "string"
            },
            "files": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "question"
          ]
        },
        "example": {
          "question": "Analyze BTC using the repository-backed expert skill.",
          "source_file": "yield_data.csv",
          "symbol": "BTC"
        }
      }
    ],
    "outputs": [
      {
        "id": "audit_report",
        "description": "Structured audit with PASS, WARNING, or FAIL status and exact evidence locations.",
        "contentType": "application/json",
        "guaranteed": true
      }
    ]
  }
}
