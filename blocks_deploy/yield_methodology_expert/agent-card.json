{
  "identity": {
    "agentName": "yield_methodology_expert",
    "displayName": "Yield Methodology Expert",
    "description": "Makes APY/APR, staking, lending, and inflation-adjusted yields comparable. Explains annualization, compounding, and methodology differences so users don't treat unlike yields as equivalent. Flags asterisked assets and reveals whether displayed percentages are meaningful for comparison.",
    "version": "1.1.0",
    "provider": {
      "organization": "Crypto Yield Matrix"
    }
  },
  "capabilities": {
    "taskKinds": [
      "request"
    ],
    "expertise": [
      "yield methodology comparison",
      "APR/APY normalization",
      "annualization audit",
      "yield mechanism classification",
      "cross-asset yield comparison"
    ],
    "dataCoverage": "59 assets, 8 quarterly periods, annualized vs non-annualized tracking"
  },
  "tags": [
    {
      "id": "domain:crypto",
      "name": "Cryptocurrency"
    },
    {
      "id": "task:yield",
      "name": "Yield methodology"
    },
    {
      "id": "task:comparison",
      "name": "Cross-asset comparison"
    },
    {
      "id": "skill:methodology",
      "name": "Methodology audit"
    },
    {
      "id": "format:json",
      "name": "Structured JSON output"
    }
  ],
  "runtime": {
    "handler": "./handler.py",
    "handlerExport": "handler",
    "concurrency": 4,
    "expectedInstances": 1,
    "maxPendingBacklog": 20,
    "maxRunningTimeSec": 45
  },
  "io": {
    "inputs": [
      {
        "id": "request",
        "description": "Yield comparison question and optional asset/category filter.",
        "contentType": "application/json",
        "required": true,
        "schema": {
          "type": "object",
          "properties": {
            "question": {
              "type": "string"
            },
            "source_file": {
              "type": "string",
              "enum": [
                "yield_data.csv"
              ]
            },
            "symbol": {
              "type": "string"
            },
            "category": {
              "type": "string"
            },
            "files": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "question"
          ]
        },
        "example": {
          "question": "Analyze BTC using the repository-backed expert skill.",
          "source_file": "yield_data.csv",
          "symbol": "BTC"
        }
      }
    ],
    "outputs": [
      {
        "id": "yield_report",
        "description": "Comparable yield analysis with methodology, annualization status, and caveats.",
        "contentType": "application/json",
        "guaranteed": true
      }
    ]
  }
}
