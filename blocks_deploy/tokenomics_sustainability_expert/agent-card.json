{
  "identity": {
    "agentName": "tokenomics_sustainability_expert",
    "displayName": "Tokenomics Sustainability Expert",
    "description": "Separates nominal yield from inflation, dilution pressure, supply dynamics, and market-cap context. Computes real-yield proxies and flags tokens where high nominal rewards are eroded by emission schedules or supply unlocks.",
    "version": "1.1.0",
    "provider": {
      "organization": "Crypto Yield Matrix"
    }
  },
  "capabilities": {
    "taskKinds": [
      "request"
    ]
  },
  "tags": [
    {
      "id": "domain:crypto",
      "name": "Cryptocurrency"
    },
    {
      "id": "task:tokenomics",
      "name": "Tokenomics sustainability"
    },
    {
      "id": "task:sustainability",
      "name": "Yield sustainability"
    },
    {
      "id": "skill:fundamental",
      "name": "Fundamental analysis"
    },
    {
      "id": "format:json",
      "name": "Structured JSON output"
    },
    {
      "id": "skill:inflation-adjusted_yield",
      "name": "inflation-adjusted yield"
    },
    {
      "id": "skill:dilution_analysis",
      "name": "dilution analysis"
    },
    {
      "id": "skill:supply_dynamics",
      "name": "supply dynamics"
    },
    {
      "id": "skill:FDV/MCAP_ratio",
      "name": "FDV/MCAP ratio"
    },
    {
      "id": "skill:token_emission_sustainability",
      "name": "token emission sustainability"
    },
    {
      "id": "info:data-coverage",
      "name": "59 assets, inflation rate, FDV/MCAP, circulating supply, market cap change"
    }
  ],
  "runtime": {
    "handler": "./handler.py",
    "handlerExport": "handler",
    "concurrency": 4,
    "expectedInstances": 1,
    "maxPendingBacklog": 20,
    "maxRunningTimeSec": 45
  },
  "io": {
    "inputs": [
      {
        "id": "request",
        "description": "Sustainability question and optional asset filter.",
        "contentType": "application/json",
        "required": true,
        "schema": {
          "type": "object",
          "properties": {
            "question": {
              "type": "string"
            },
            "source_file": {
              "type": "string",
              "enum": [
                "yield_data.csv"
              ]
            },
            "symbol": {
              "type": "string"
            },
            "category": {
              "type": "string"
            },
            "files": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "question"
          ]
        },
        "example": {
          "question": "Analyze BTC using the repository-backed expert skill.",
          "source_file": "yield_data.csv",
          "symbol": "BTC"
        }
      }
    ],
    "outputs": [
      {
        "id": "sustainability_report",
        "description": "Transparent nominal-yield, inflation, dilution, and supply report.",
        "contentType": "application/json",
        "guaranteed": true
      }
    ]
  }
}
