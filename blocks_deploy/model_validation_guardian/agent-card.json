{
  "identity": {
    "agentName": "model_validation_guardian",
    "displayName": "Model Validation Guardian",
    "description": "Checks duplicate provenance rows, target circularity, temporal leakage, split integrity, calibration, baselines, and uncertainty before a crypto model is trusted.",
    "version": "1.1.0",
    "provider": {
      "organization": "Crypto Yield Matrix"
    }
  },
  "capabilities": {
    "taskKinds": [
      "request"
    ]
  },
  "tags": [
    {
      "id": "validation",
      "name": "Model validation and leakage control"
    }
  ],
  "runtime": {
    "handler": "./handler.py",
    "handlerExport": "handler",
    "concurrency": 4,
    "expectedInstances": 1,
    "maxPendingBacklog": 20,
    "maxRunningTimeSec": 45
  },
  "io": {
    "inputs": [
      {
        "id": "request",
        "description": "Model target, feature list, source selection, and proposed split/evaluation plan.",
        "contentType": "application/json",
        "required": true,
        "schema": {
          "type": "object",
          "properties": {
            "question": {
              "type": "string"
            },
            "source_file": {
              "type": "string",
              "enum": [
                "yield_data.csv",
                "yield_data.csv"
              ]
            },
            "symbol": {
              "type": "string"
            },
            "category": {
              "type": "string"
            },
            "files": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "question"
          ]
        },
        "example": {
          "question": "Analyze BTC using the repository-backed expert skill.",
          "source_file": "yield_data.csv",
          "symbol": "BTC"
        }
      }
    ],
    "outputs": [
      {
        "id": "validation_gate",
        "description": "PASS, WARNING, or FAIL gate with leakage, circularity, split, calibration, and uncertainty findings.",
        "contentType": "application/json",
        "guaranteed": true
      }
    ]
  }
}
