{
  "identity": {
    "agentName": "model_validation_guardian",
    "displayName": "Model Validation Guardian",
    "description": "Blocks unsafe modeling practices before they produce misleading results. Checks for duplicate provenance rows as independent observations, target circularity, temporal leakage, invalid splits, and missing baselines. Returns PASS/WARNING/FAIL gates with exact remediation steps.",
    "version": "1.1.0",
    "provider": {
      "organization": "Crypto Yield Matrix"
    }
  },
  "capabilities": {
    "taskKinds": [
      "request"
    ]
  },
  "tags": [
    {
      "id": "domain:crypto",
      "name": "Cryptocurrency"
    },
    {
      "id": "task:validation",
      "name": "Model validation"
    },
    {
      "id": "task:safety",
      "name": "Safety gate"
    },
    {
      "id": "skill:ml-ops",
      "name": "ML operations"
    },
    {
      "id": "format:json",
      "name": "Structured JSON output"
    },
    {
      "id": "skill:model_validation",
      "name": "model validation"
    },
    {
      "id": "skill:leakage_detection",
      "name": "leakage detection"
    },
    {
      "id": "skill:split_integrity",
      "name": "split integrity"
    },
    {
      "id": "skill:baseline_comparison",
      "name": "baseline comparison"
    },
    {
      "id": "skill:calibration_audit",
      "name": "calibration audit"
    },
    {
      "id": "skill:uncertainty_reporting",
      "name": "uncertainty reporting"
    },
    {
      "id": "info:data-coverage",
      "name": "Full dataset validation: provenance awareness, chronological ordering, feature/t"
    }
  ],
  "runtime": {
    "handler": "./handler.py",
    "handlerExport": "handler",
    "concurrency": 4,
    "expectedInstances": 1,
    "maxPendingBacklog": 20,
    "maxRunningTimeSec": 45
  },
  "io": {
    "inputs": [
      {
        "id": "request",
        "description": "Model target, feature list, source selection, and proposed split/evaluation plan.",
        "contentType": "application/json",
        "required": true,
        "schema": {
          "type": "object",
          "properties": {
            "question": {
              "type": "string"
            },
            "source_file": {
              "type": "string",
              "enum": [
                "yield_data.csv"
              ]
            },
            "symbol": {
              "type": "string"
            },
            "category": {
              "type": "string"
            },
            "files": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "question"
          ]
        },
        "example": {
          "question": "Analyze BTC using the repository-backed expert skill.",
          "source_file": "yield_data.csv",
          "symbol": "BTC"
        }
      }
    ],
    "outputs": [
      {
        "id": "validation_gate",
        "description": "PASS, WARNING, or FAIL gate with leakage, circularity, split, calibration, and uncertainty findings.",
        "contentType": "application/json",
        "guaranteed": true
      }
    ]
  }
}
