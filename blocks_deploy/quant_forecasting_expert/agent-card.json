{
  "identity": {
    "agentName": "quant_forecasting_expert",
    "displayName": "Quantitative Yield Forecasting Expert",
    "description": "Designs cautious quarterly yield forecasts only after source reconciliation, chronological validation, baseline comparison, and uncertainty reporting. Returns a readiness FAIL gate when data is insufficient \u2014 currently active because the 8-quarter panel lacks sufficient dated history for validated forecasting.",
    "version": "1.1.0",
    "provider": {
      "organization": "Crypto Yield Matrix"
    }
  },
  "capabilities": {
    "taskKinds": [
      "request"
    ],
    "expertise": [
      "time-series forecasting",
      "walk-forward validation",
      "baseline comparison",
      "uncertainty quantification",
      "forecast readiness assessment"
    ],
    "dataCoverage": "8 quarterly periods, 59 assets, yield_trend_slope, yield_volatility, momentum indicators"
  },
  "tags": [
    {
      "id": "domain:crypto",
      "name": "Cryptocurrency"
    },
    {
      "id": "task:forecasting",
      "name": "Yield forecasting"
    },
    {
      "id": "task:safety",
      "name": "Safety gate"
    },
    {
      "id": "skill:quantitative",
      "name": "Quantitative modeling"
    },
    {
      "id": "skill:uncertainty",
      "name": "Uncertainty quantification"
    },
    {
      "id": "format:json",
      "name": "Structured JSON output"
    }
  ],
  "runtime": {
    "handler": "./handler.py",
    "handlerExport": "handler",
    "concurrency": 4,
    "expectedInstances": 1,
    "maxPendingBacklog": 20,
    "maxRunningTimeSec": 45
  },
  "io": {
    "inputs": [
      {
        "id": "request",
        "description": "Forecast design question with target horizon and source selection.",
        "contentType": "application/json",
        "required": true,
        "schema": {
          "type": "object",
          "properties": {
            "question": {
              "type": "string"
            },
            "source_file": {
              "type": "string",
              "enum": [
                "yield_data.csv"
              ]
            },
            "symbol": {
              "type": "string"
            },
            "category": {
              "type": "string"
            },
            "files": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "question"
          ]
        },
        "example": {
          "question": "Analyze BTC using the repository-backed expert skill.",
          "source_file": "yield_data.csv",
          "symbol": "BTC"
        }
      }
    ],
    "outputs": [
      {
        "id": "forecast_design",
        "description": "Forecast specification or result with baseline, time split, uncertainty, and data-readiness gate.",
        "contentType": "application/json",
        "guaranteed": true
      }
    ]
  }
}
