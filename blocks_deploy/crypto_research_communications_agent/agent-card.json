{
  "identity": {
    "agentName": "crypto_research_communications_agent",
    "displayName": "Crypto Research Communications Agent",
    "description": "Produces concise, traceable, non-advisory crypto research communications. Distinguishes observed, estimated, derived, and target data with exact evidence locations. Formats output as Markdown or JSON with executive summary, methodology, limitations, and responsible disclosure language.",
    "version": "1.1.0",
    "provider": {
      "organization": "Crypto Yield Matrix"
    }
  },
  "capabilities": {
    "taskKinds": [
      "request"
    ],
    "expertise": [
      "research writing",
      "evidence synthesis",
      "data-status labeling",
      "audience adaptation",
      "disclosure compliance"
    ],
    "dataCoverage": "Full project context: yield matrix, risk metrics, liquidity data, provenance audit, methodology notes"
  },
  "tags": [
    {
      "id": "domain:crypto",
      "name": "Cryptocurrency"
    },
    {
      "id": "task:research",
      "name": "Research communication"
    },
    {
      "id": "task:disclosure",
      "name": "Disclosure and compliance"
    },
    {
      "id": "skill:writing",
      "name": "Technical writing"
    },
    {
      "id": "format:markdown",
      "name": "Markdown output"
    },
    {
      "id": "format:json",
      "name": "JSON output"
    }
  ],
  "runtime": {
    "handler": "./handler.py",
    "handlerExport": "handler",
    "concurrency": 4,
    "expectedInstances": 1,
    "maxPendingBacklog": 20,
    "maxRunningTimeSec": 45
  },
  "io": {
    "inputs": [
      {
        "id": "request",
        "description": "Requested research note, asset scope, audience, and desired length.",
        "contentType": "application/json",
        "required": true,
        "schema": {
          "type": "object",
          "properties": {
            "question": {
              "type": "string"
            },
            "source_file": {
              "type": "string",
              "enum": [
                "yield_data.csv"
              ]
            },
            "symbol": {
              "type": "string"
            },
            "category": {
              "type": "string"
            },
            "files": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "question"
          ]
        },
        "example": {
          "question": "Analyze BTC using the repository-backed expert skill.",
          "source_file": "yield_data.csv",
          "symbol": "BTC"
        }
      }
    ],
    "outputs": [
      {
        "id": "research_note",
        "description": "Evidence-linked Markdown or JSON note with assumptions, limitations, and non-advisory language.",
        "contentType": "application/json",
        "guaranteed": true
      }
    ]
  }
}
