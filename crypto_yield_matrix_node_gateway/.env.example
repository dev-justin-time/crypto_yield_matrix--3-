# Server-side Blocks credential; never expose this to callers.
BLOCKS_API_KEY=
# Separate caller credentials: clientId=secret, comma-separated.
GATEWAY_CLIENT_KEYS=research_app=replace_with_a_random_secret_at_least_16_chars
# Optional per-client agent allowlists: clientId=agent_name|agent_name
GATEWAY_CLIENT_AGENTS=research_app=crypto_risk_analyst|matrix_research_insights_agent
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=3000
# Public bind is refused unless explicitly acknowledged and placed behind a verified private edge.
GATEWAY_ALLOW_PUBLIC_BIND=false
GATEWAY_RELEASE_ID=local
GATEWAY_TASK_TIMEOUT_MS=120000
GATEWAY_MAX_BODY_BYTES=1000000
GATEWAY_MAX_ARTIFACT_BYTES=5242880
GATEWAY_MAX_ARTIFACT_COUNT=32
GATEWAY_MAX_QUESTION_CHARS=4000
GATEWAY_MAX_CONCURRENT_TASKS=8
GATEWAY_MAX_REQUESTS_PER_MINUTE=30
GATEWAY_MAX_DAILY_TASKS=100
GATEWAY_MAX_DAILY_SPEND_USD=10
GATEWAY_TASK_COST_USD=0.10
GATEWAY_BUDGET_STATE_FILE=.gateway-state/budget.json
# Create this file to stop all new paid dispatches; remove it to resume.
GATEWAY_KILL_SWITCH_FILE=.gateway-state/PAUSE_PAID_TASKS
# LLM defaults to local Ollama; the gateway never stores user-supplied hosted keys.
LLM_DEFAULT_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
LLM_HOSTED_BASE_URL=
# Comma-separated HTTPS host allowlist, e.g. api.openai.com
LLM_HOSTED_ALLOWED_HOSTS=
LLM_TIMEOUT_MS=120000
LLM_MAX_RESPONSE_BYTES=1000000
LLM_MAX_CONCURRENT=2
LLM_MAX_REQUESTS_PER_MINUTE=10
