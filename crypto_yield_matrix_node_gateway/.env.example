# Server-side Blocks credential; never expose this to callers.
BLOCKS_API_KEY=
# Separate caller credentials: clientId=secret, comma-separated.
GATEWAY_CLIENT_KEYS=research_app=replace_with_a_random_secret_at_least_16_chars
GATEWAY_PORT=3000
GATEWAY_TASK_TIMEOUT_MS=120000
GATEWAY_MAX_BODY_BYTES=1000000
GATEWAY_MAX_QUESTION_CHARS=4000
GATEWAY_MAX_CONCURRENT_TASKS=8
GATEWAY_MAX_REQUESTS_PER_MINUTE=30
GATEWAY_MAX_DAILY_TASKS=100
GATEWAY_MAX_DAILY_SPEND_USD=10
GATEWAY_TASK_COST_USD=0.10
