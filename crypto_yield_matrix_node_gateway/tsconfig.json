{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "index.ts",
    "server.ts",
    "agents.ts",
    "smoke.ts",
    "resilience.ts",
    "llm.ts",
    "llm_smoke.ts"
  ]
}
