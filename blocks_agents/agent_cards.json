{
  "schemaVersion": "1.0.0",
  "project": "crypto_yield_matrix",
  "compatibility": {
    "platform": "Blocks.ai",
    "manifestType": "agent-card",
    "taskKinds": ["request"],
    "runtimeMode": "local scaffold",
    "published": false,
    "credentialsRequired": false,
    "officialDocs": ["https://blocks.ai/docs", "https://blocks.ai/docs/key-concepts"]
  },
  "sharedContextFiles": [
    "validate.md",
    "DATA_DICTIONARY.md",
    "yield_data.csv",
    "yield_data1.csv",
    "consolidated_yield_data.csv",
    "index.html",
    "matrix.js",
    "styles.css"
  ],
  "sharedHandlerContract": {
    "module": "blocks_agents.handlers.common",
    "inputPartId": "request",
    "request": "JSON object encoded in requestParts[0].text",
    "output": "{ artifacts: [{ data: JSON string, mimeType: application/json }] }",
    "requiredEnvelopeFields": ["agent", "status", "summary", "findings", "assumptions", "limitations", "provenance"],
    "filesystemPolicy": "repository read-only; handlers do not mutate source datasets"
  },
  "agents": [
    "data_provenance_auditor.json",
    "yield_methodology_expert.json",
    "crypto_risk_analyst.json",
    "defi_liquidity_analyst.json",
    "tokenomics_sustainability_expert.json",
    "quant_forecasting_expert.json",
    "portfolio_scenario_expert.json",
    "model_validation_guardian.json",
    "matrix_research_insights_agent.json",
    "crypto_research_communications_agent.json",
    "feature_engineering_expert.json"
  ],
  "handlers": {
    "directory": "blocks_agents/handlers",
    "shared": "blocks_agents/handlers/common.py",
    "language": "python",
    "dependencies": "Python standard library only",
    "featureDefinitions": {
      "yield_momentum": "yield_trend_slope * yield_volatility",
      "mcap_to_tvl": "mcap_end_current_usd / tvl_usd",
      "risk_score": "beta_vs_btc * volatility_annualized_current / sharpe_ratio_current",
      "yield_premium": "agg_current - yield_vs_category_avg"
    }
  }
}
