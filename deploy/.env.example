[TEMPLATE]
# Local/deployment template only. Never commit real secrets.
# Blocks consumer credential used only by the server-side TaskClient.
BLOCKS_API_KEY=
# Gateway caller credentials: comma-separated clientId=secret entries.
# Secrets must be at least 16 characters and must not equal BLOCKS_API_KEY.
GATEWAY_CLIENT_KEYS=demo=replace_with_a_random_32_character_secret
# Optional per-client agent allowlists: clientId=agent_name|agent_name
GATEWAY_CLIENT_AGENTS=demo=crypto_risk_analyst|matrix_research_insights_agent
# Paid-task safety controls.
GATEWAY_MAX_DAILY_TASKS=100
GATEWAY_MAX_DAILY_SPEND_USD=10
GATEWAY_TASK_COST_USD=0.10
GATEWAY_BUDGET_STATE_FILE=.gateway-state/budget.json
GATEWAY_MAX_REQUESTS_PER_MINUTE=30
GATEWAY_MAX_CONCURRENT_TASKS=8
GATEWAY_MAX_BODY_BYTES=1000000
GATEWAY_MAX_QUESTION_CHARS=4000
GATEWAY_TASK_TIMEOUT_MS=120000
